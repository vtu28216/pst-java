import java.util.function.Function;
public class ProcessSalary {
    static void processSalary(double salary, Function<Double, Double> operation) {
        double result = operation.apply(salary);
        System.out.println("Updated Salary: " + result);
    }
    public static void main(String[] args) {
        double salary = 50000;
        processSalary(salary, s -> s + (s * 0.10));
         processSalary(salary, s -> s + (s * 0.10));
        processSalary(salary, s -> s - (s * 0.10));
    }
}
